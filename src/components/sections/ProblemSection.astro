---
import Container from '@/components/ui/Container.astro';

import SectionChevron from '@/components/ui/SectionChevron.astro';
import { painSection, painBullets } from '@/data/painPoints';
---

<section class="relative bg-bg-alt py-16 md:py-section-gap">
  <SectionChevron class="bg-bg-alt" />
  <Container class="grid md:grid-cols-2 gap-10 md:gap-16 items-center">
    <div>
      <h2 class="font-display font-light text-[30px] leading-[1.12] md:text-[50px] text-navy-700 mb-10">
        {painSection.titleMain} <strong class="font-600 text-blue">{painSection.titleAccent}</strong>
      </h2>
      <ul class="flex flex-col gap-5">
        {painBullets.map((bullet) => (
          <li class="flex items-start gap-3.5 text-[17px] text-slate">
            <span class="w-2 h-2 rounded-full bg-blue-light mt-2 shrink-0"></span>
            <span>{bullet.prefix}<strong class="font-700 text-ink">{bullet.bold}</strong>{bullet.suffix}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="relative h-[320px] md:h-[560px]">
      <div class="absolute left-0 top-0 w-[66%] h-[60%] rounded-2xl overflow-hidden shadow-lg flex items-center justify-center bg-gray-100">
        <img src="/img/1.webp" alt="Ilustração metabólica" class="w-full h-full object-cover object-center" />
      </div>
      <div class="absolute right-0 top-[34%] w-[60%] h-[56%] rounded-2xl overflow-hidden shadow-lg flex items-center justify-center bg-gray-100">
        <img src="/img/2.webp" alt="Paciente em consulta" class="w-full h-full object-cover object-center" />
      </div>
      <div class="absolute left-[8%] bottom-[14%] w-[52%] bg-white/95 backdrop-blur rounded-xl p-6 text-[15px] leading-relaxed text-slate shadow-[0_16px_40px_rgba(13,43,71,0.14)]">
        {painSection.calloutQuote} <strong class="text-navy-700">{painSection.calloutAccent}</strong>
      </div>
    </div>
  </Container>
</section>
