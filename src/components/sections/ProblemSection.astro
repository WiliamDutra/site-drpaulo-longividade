---
import Container from '@/components/ui/Container.astro';
import SectionChevron from '@/components/ui/SectionChevron.astro';
import ExpandableGallery from '@/components/ui/ExpandableGallery.tsx';
import { doctor } from '@/data/site';

const galleryImages = [
  '/img/longevitare-001.webp',
  '/img/longevitare-002.webp',
  '/img/longevitare-003.webp',
  '/img/longevitare-004.webp',
  '/img/longevitare-005.webp',
];
---

<section class="relative bg-bg-alt py-16 md:py-section-gap">
  <SectionChevron class="bg-bg-alt" />
  <Container class="flex flex-col gap-10 md:gap-12">
    <div class="max-w-2xl">
      <div class="flex items-center gap-3 mb-6">
        <img src="/img/logo-marca-semfundo.webp" alt="Instituto Longevitare" class="h-12 md:h-14 w-auto" />
        <span class="leading-tight">
          <span class="block font-display text-xl md:text-2xl tracking-wide text-slate">Instituto Longevitare</span>
          <span class="block text-[9px] md:text-[10px] tracking-[0.14em] uppercase text-slate-light">Saúde metabólica e Longevidade</span>
        </span>
      </div>
      <h2 class="font-display font-light text-[30px] leading-[1.12] md:text-[50px] text-navy-700 mb-10">
        Conheça o <strong class="font-600 text-blue">Instituto Longevitare</strong>
      </h2>
      <p class="text-[17px] leading-relaxed text-slate">
        Mais de {doctor.yearsOfPractice} anos de medicina e {doctor.patientsServed} pacientes tratados com ciência, critério clínico e acompanhamento real — não com dietas da moda.
      </p>
    </div>

    <ExpandableGallery client:visible images={galleryImages} />
  </Container>
</section>
