---
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import SocialProofLine from '@/components/ui/SocialProofLine.astro';
import ArrowUpRightIcon from '@/components/icons/arrow-up-right-icon.astro';
import MailIcon from '@/components/icons/mail-icon.astro';
import InstagramIcon from '@/components/icons/instagram-icon.astro';
import { buildWhatsAppLink, contact, social, whatsapp } from '@/data/site';

const inputClass =
  'w-full border-[1.6px] border-border rounded-xl px-4 py-[15px] text-[16px] text-[#16283a] bg-white outline-none focus:border-blue transition-colors';
const labelClass = 'flex flex-col gap-2.5 text-sm text-slate';
---

<section id="agendar" class="bg-bg-alt">
  <div class="max-w-xl mx-auto px-6 py-16 md:py-24 flex flex-col">
    <span class="flex items-center gap-3 label-caps font-500 text-blue-light mb-5">
      <span class="w-7 h-px bg-blue-light"></span>
      Chega de viver adiando
    </span>
    <h2 class="font-display font-light text-[30px] leading-[1.12] md:text-[50px] text-navy-700 mb-7">
      Agende a sua <strong class="font-600">consulta comigo</strong>
    </h2>
    <p class="text-[16px] leading-relaxed text-slate max-w-sm mb-10">
      Preencha o formulário ou fale direto pelo WhatsApp — a equipe responde para confirmar o melhor horário.
    </p>


    <div class="flex flex-col gap-3 mb-10">
      <a
        href={social.doctorInstagram.url}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-3.5 p-3.5 rounded-xl border border-border-soft bg-white hover:border-blue-pale/50 hover:shadow-[0_8px_20px_rgba(13,43,71,0.08)] transition-all"
      >
        <span class="flex items-center justify-center w-10 h-10 rounded-full bg-blue/10 text-blue shrink-0 group-hover:bg-blue group-hover:text-white transition-colors">
          <InstagramIcon class="w-5 h-5" />
        </span>
        <div>
          <p class="text-xs text-slate-light uppercase tracking-wide">Dr. Paulo Mansur</p>
          <p class="text-[15px] font-600 text-ink">{social.doctorInstagram.handle}</p>
        </div>
      </a>
      <a
        href={social.instituteInstagram.url}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-3.5 p-3.5 rounded-xl border border-border-soft bg-white hover:border-blue-pale/50 hover:shadow-[0_8px_20px_rgba(13,43,71,0.08)] transition-all"
      >
        <span class="flex items-center justify-center w-10 h-10 rounded-full bg-blue/10 text-blue shrink-0 group-hover:bg-blue group-hover:text-white transition-colors">
          <InstagramIcon class="w-5 h-5" />
        </span>
        <div>
          <p class="text-xs text-slate-light uppercase tracking-wide">Instituto Longevitare</p>
          <p class="text-[15px] font-600 text-ink">{social.instituteInstagram.handle}</p>
        </div>
      </a>
    </div>

    <Button href={buildWhatsAppLink()} target="_blank" variant="whatsapp">Enviar mensagem no WhatsApp</Button>
  </div>

  {/* Formulário de agendamento comentado temporariamente */}
