---
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { reviewImages } from '@/data/reviews';
---

<section id="depoimentos" class="bg-bg-alt py-16 md:py-section-gap">
  <Container class="flex flex-col items-center text-center gap-16">
    <SectionHeading eyebrow="Saúde metabólica &amp; Longevidade" align="center" class="max-w-2xl">
      O que nossos <strong class="font-600 text-blue">pacientes dizem?</strong>
    </SectionHeading>
    <p class="text-[16px] text-slate max-w-xl -mt-10">
      Avaliações reais de pacientes no Google, sobre a experiência de atendimento no Instituto Longevitare.
    </p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 w-full">
      {reviewImages.map((src) => (
        <div class="rounded-2xl border border-border bg-white shadow-sm overflow-hidden">
          <img src={src} alt="Avaliação de paciente no Google" class="w-full h-auto" loading="lazy" />
        </div>
      ))}
    </div>
  </Container>
</section>
