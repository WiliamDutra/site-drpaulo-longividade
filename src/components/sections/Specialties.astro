---
import { Icon } from 'astro-icon/components';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import { specialties } from '@/data/specialties';
import { buildWhatsAppLink } from '@/data/site';
---

<section id="especialidades" class="bg-bg py-16 md:py-section-gap">
  <Container class="flex flex-col items-center text-center gap-16">
    <SectionHeading eyebrow="Nutrologia &amp; Longevidade" align="center" class="max-w-2xl">
      Veja como o Dr. Paulo <strong class="font-600 text-blue">pode te ajudar</strong>
    </SectionHeading>
    <p class="text-[17px] text-slate max-w-xl -mt-10">
      Atendimento especializado nas principais frentes de emagrecimento e saúde metabólica, com foco em diagnóstico correto e tratamento efetivo.
    </p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 w-full text-left">
      {specialties.map((specialty) => (
        <div class="rounded-2xl border border-border bg-white p-8 flex flex-col gap-4 transition-shadow hover:shadow-[0_12px_30px_rgba(13,43,71,0.07)] hover:border-blue-pale/40">
          <span class="w-11 h-11 rounded-xl bg-navy-700 text-white flex items-center justify-center">
            <Icon name={specialty.icon} class="w-5 h-5" />
          </span>
          <h3 class="text-xl font-700 text-blue">{specialty.title}</h3>
          <p class="text-[15px] text-slate leading-relaxed">{specialty.description}</p>
        </div>
      ))}
    </div>

    <div class="flex flex-col items-center gap-8">
      <p class="font-display font-light text-[26px] md:text-[32px] text-navy-700">
        Agende sua consulta <strong class="font-600">e descubra como eu posso te ajudar</strong>
      </p>
      <Button href={buildWhatsAppLink()} target="_blank">Agendar minha avaliação</Button>
    </div>
  </Container>
</section>
