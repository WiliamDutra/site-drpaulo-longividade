---
import VerifiedBadgeIcon from '@/components/icons/verified-badge-icon.astro';

interface Props {
  text: string;
  class?: string;
}

const { text, class: className } = Astro.props;
---

<div
  class={[
    'static md:absolute inline-flex items-center gap-2.5 rounded-xl bg-white/85 backdrop-blur-md px-4 py-3 mr-2 mt-2 md:mr-0 md:mt-0 shadow-[0_8px_24px_rgba(13,43,71,0.1)]',
    className,
  ]
    .filter(Boolean)
    .join(' ')}
>
  <VerifiedBadgeIcon class="w-4 h-4 text-blue shrink-0" />
  <span class="text-sm text-ink whitespace-nowrap">{text}</span>
</div>
