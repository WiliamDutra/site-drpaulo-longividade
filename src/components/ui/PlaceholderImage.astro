---
// Placeholder visual para fotos reais que ainda não foram fornecidas.
// Buscar por "PlaceholderImage" quando as fotos definitivas chegarem.
interface Props {
  label: string;
  aspectRatio?: string;
  class?: string;
}

const { label, aspectRatio = '4 / 5', class: className } = Astro.props;
---

<div
  class={['flex items-center justify-center rounded-2xl border border-dashed border-blue/40 bg-bg-soft', className]
    .filter(Boolean)
    .join(' ')}
  style={`aspect-ratio: ${aspectRatio};`}
>
  <div class="flex flex-col items-center gap-3 px-6 text-center">
    <svg
      class="text-blue/50"
      width="32"
      height="32"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <circle cx="9" cy="10" r="1.5" />
      <path d="M3 16l5-4 4 3 3-3 6 5" />
    </svg>
    <span class="label-caps text-slate-light">[FOTO: {label} — substituir em produção]</span>
  </div>
</div>
