---
import StarRating from '@/components/ui/StarRating.astro';
import VerifiedBadgeIcon from '@/components/icons/verified-badge-icon.astro';

interface Props {
  name: string;
  initial: string;
  date: string;
  rating: number;
  quote: string;
  color: string;
}

const { name, initial, date, rating, quote, color } = Astro.props;
---

<div class="flex flex-col gap-3">
  <div class="flex items-center gap-3">
    <span
      class="flex items-center justify-center w-9 h-9 rounded-full text-white font-700 text-sm shrink-0"
      style={`background:${color}`}
    >
      {initial}
    </span>
    <div class="min-w-0 flex-1">
      <p class="text-ink font-700 text-sm truncate">{name}</p>
      <p class="text-slate-light text-xs">{date}</p>
    </div>
    <VerifiedBadgeIcon class="w-4 h-4 text-blue shrink-0" />
  </div>
  <StarRating rating={rating} variant="amber" />
  <p class="text-slate text-sm leading-relaxed">{quote}</p>
</div>
